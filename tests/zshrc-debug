#!/usr/bin/env zsh
# Debug version of .zshrc with timing for each section

_t0=$(date +%s%N 2>/dev/null || date +%s)
_section_start=$_t0

_timing_report() {
    local label="$1"
    local now
    now=$(date +%s%N 2>/dev/null || echo "0")
    if [[ "$now" != "0" && "$_section_start" != "0" ]]; then
        local elapsed=$(( (now - _section_start) / 1000000 ))
        printf "TIMING: %-50s %dms\n" "$label" "$elapsed"
    else
        echo "TIMING: $label (no nanosecond timer)"
    fi
    _section_start=$now
}

